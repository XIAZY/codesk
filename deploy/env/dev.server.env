# Non-secret local development defaults for docker compose.
# Use with: docker compose --env-file deploy/env/dev.server.env up --build
# Backend email secrets are loaded from git-ignored deploy/env/local.email.env.

NOTTY_POSTGRES_PORT=5432
NOTTY_BACKEND_PORT=8080
NOTTY_FRONTEND_PORT=5173
NOTTY_STATIC_PORT=5174

NOTTY_FRONTEND_ORIGIN=http://localhost:5173
NOTTY_BACKEND_ORIGIN=http://localhost:8080
NOTTY_STATIC_ORIGIN=http://localhost:5174
NOTTY_DAEMON_STATIC_BASE=http://localhost:5174/daemons

# Optional daemon profile inputs for local development.
NOTTY_WORKSPACE_ID=
NOTTY_DAEMON_TOKEN=
