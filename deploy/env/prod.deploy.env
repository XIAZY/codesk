# Non-secret defaults for the machine running the Make deploy targets.
# Secrets stay out of git:
# - Cloudflare token: export CLOUDFLARE_API_TOKEN or NOTTY_CLOUDFLARE_TOKEN locally.
# - Backend database/JWT/API key secrets: store in /opt/notty/secrets.env on the server.

DOCKER_REPO=alphatoad/notty
DOCKER_PLATFORMS=linux/amd64,linux/arm64

NOTTY_DEPLOY_SSH_HOST=notty
NOTTY_REMOTE_DIR=/opt/notty

# Baked into the static frontend build and the daemon install command by
# scripts/build-frontend.sh. Point these at the new domain to migrate new installs.
NOTTY_FRONTEND_ORIGIN=https://app.getcodesk.com
NOTTY_BACKEND_ORIGIN=https://api.getcodesk.com
NOTTY_STATIC_ORIGIN=https://static.getcodesk.com
NOTTY_DAEMON_STATIC_BASE=https://static.getcodesk.com/daemons

CLOUDFLARE_ACCOUNT_ID=d8cad58199d138868f519a3a55c7e3c5
CLOUDFLARE_ZONE_ID=13c58066cad25972d187f3da3ab42445
R2_ENDPOINT_URL=https://d8cad58199d138868f519a3a55c7e3c5.r2.cloudflarestorage.com
R2_HOMEPAGE_BUCKET=notty-homepage-prod
R2_HOMEPAGE_PREFIX=
R2_APP_BUCKET=notty-app-prod
R2_APP_PREFIX=
R2_DAEMONS_BUCKET=notty-static-prod
R2_DAEMONS_PREFIX=daemons
R2_DESKTOP_BUCKET=notty-static-prod
R2_DESKTOP_PREFIX=desktop
