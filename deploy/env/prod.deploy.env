# Non-secret defaults for the machine running scripts/deploy-notty.sh.
# Secrets stay out of git:
# - Cloudflare token: export CLOUDFLARE_API_TOKEN or NOTTY_CLOUDFLARE_TOKEN locally.
# - Backend database/JWT secrets: store in /opt/notty/.env on the server.

DOCKER_REPO=alphatoad/notty
DOCKER_PLATFORMS=linux/amd64,linux/arm64
DAEMON_PLATFORMS=all

NOTTY_DEPLOY_SSH_HOST=notty
NOTTY_REMOTE_DIR=/opt/notty
PUBLISH_STATIC=1

NOTTY_HOMEPAGE_ORIGIN=https://nottyai.co
NOTTY_FRONTEND_ORIGIN=https://app.nottyai.co
NOTTY_BACKEND_ORIGIN=https://api.nottyai.co
NOTTY_STATIC_ORIGIN=https://static.nottyai.co
NOTTY_DAEMON_STATIC_BASE=https://static.nottyai.co/daemons

CLOUDFLARE_ACCOUNT_ID=d8cad58199d138868f519a3a55c7e3c5
CLOUDFLARE_ZONE_ID=13c58066cad25972d187f3da3ab42445
R2_ENDPOINT_URL=https://d8cad58199d138868f519a3a55c7e3c5.r2.cloudflarestorage.com
R2_HOMEPAGE_BUCKET=notty-homepage-prod
R2_HOMEPAGE_PREFIX=
R2_APP_BUCKET=notty-app-prod
R2_APP_PREFIX=
R2_DAEMONS_BUCKET=notty-static-prod
R2_DAEMONS_PREFIX=daemons

NOTTY_HOMEPAGE_DOMAIN=nottyai.co
NOTTY_HOMEPAGE_R2_KEY=index.html
NOTTY_APP_DOMAIN=app.nottyai.co
NOTTY_APP_R2_KEY=index.html
