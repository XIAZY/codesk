# Local email settings for docker-compose.yml.
#
# Copy this file to deploy/env/local.email.env and fill in real Mailgun values
# before running `make dev` or `docker compose --env-file deploy/env/dev.server.env up --build`.
# The backend refuses to start without working email configuration.

NOTTY_MAILGUN_DOMAIN=mail.getcodesk.com
NOTTY_MAILGUN_API_KEY=replace-with-mailgun-api-key
NOTTY_MAILGUN_FROM=noreply@mail.getcodesk.com

# NOTTY_REQUIRE_EMAIL defaults to true. Setting it to false is rejected.
# NOTTY_REQUIRE_EMAIL=1
