# Non-secret production backend runtime defaults.
# Copied to /opt/notty/notty.server.env by scripts/deploy-notty.sh.
# Keep NOTTY_DATABASE_URL and NOTTY_JWT_SECRET in /opt/notty/.env, not here.

NOTTY_BACKEND_IMAGE=alphatoad/notty:backend-latest
NOTTY_BACKEND_BIND=127.0.0.1
NOTTY_BACKEND_PORT=8080
NOTTY_PUBLIC_ORIGIN=https://app.nottyai.co
NOTTY_PPROF_ADDR=
