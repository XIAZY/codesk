# Non-secret production backend runtime defaults.
# Copied to /opt/notty/notty.server.env by scripts/deploy-notty.sh.
# Keep NOTTY_DATABASE_URL and NOTTY_JWT_SECRET in /opt/notty/.env, not here.

NOTTY_BACKEND_IMAGE=alphatoad/notty:backend-latest
NOTTY_HTTP_BIND=0.0.0.0
NOTTY_HTTP_PORT=80
NOTTY_HTTPS_BIND=0.0.0.0
NOTTY_HTTPS_PORT=443
NOTTY_HOMEPAGE_ORIGIN=https://nottyai.co
NOTTY_WWW_HOMEPAGE_ORIGIN=https://www.nottyai.co
NOTTY_FRONTEND_ORIGIN=https://app.nottyai.co
NOTTY_BACKEND_ORIGIN=https://api.nottyai.co
NOTTY_STATIC_ORIGIN=https://static.nottyai.co
NOTTY_API_HOST=api.nottyai.co
NOTTY_TLS_CERT_FILE=/opt/notty/cert.pem
NOTTY_TLS_KEY_FILE=/opt/notty/private.pem
NOTTY_PUBLIC_ORIGIN=https://app.nottyai.co
NOTTY_PPROF_ADDR=
