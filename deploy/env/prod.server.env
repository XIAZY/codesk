# Non-secret production backend runtime defaults.
# Copied to /opt/notty/notty.server.env by scripts/deploy-backend.sh.
# Keep NOTTY_DATABASE_URL, NOTTY_JWT_SECRET, and API keys in
# /opt/notty/secrets.env, not here.

# NOTTY_BACKEND_IMAGE is intentionally not set here. scripts/deploy-backend.sh
# passes an immutable backend-$VERSION image; direct compose users must export it.
NOTTY_HTTP_BIND=0.0.0.0
NOTTY_HTTP_PORT=80
NOTTY_HTTPS_BIND=0.0.0.0
NOTTY_HTTPS_PORT=443
# Used by compose.prod.yml: NOTTY_API_HOST (nginx healthcheck Host header) and
# NOTTY_PUBLIC_ORIGIN (backend public origin). nginx origins/TLS paths are
# hardcoded in deploy/nginx/notty-api.conf, not here.
NOTTY_API_HOST=api.getcodesk.com
NOTTY_PORT=8080
NOTTY_PUBLIC_ORIGIN=https://app.getcodesk.com
NOTTY_PPROF_ADDR=
NOTTY_MAILGUN_DOMAIN=mail.getcodesk.com
NOTTY_MAILGUN_FROM=noreply@mail.getcodesk.com
NOTTY_REQUIRE_EMAIL=1
