# Production backend secrets.
# Copy this file to /opt/notty/.env on the production server and fill values there.
# Non-secret deployment defaults live in deploy/env/prod.server.env and
# deploy/env/prod.deploy.env.
# Do not commit real credentials.

NOTTY_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
NOTTY_JWT_SECRET=replace-with-a-long-random-secret
